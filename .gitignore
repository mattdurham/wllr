# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
/wllr
/bin/wllr
*.exe
*.exe~
*.dll
*.so
*.dylib
*.a
*.o
*.bin

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Credentials and local runtime config. The real files live outside the repo
# (~/.config/wllr/auth.json, mode 0600), but a copy made inside the tree — or a
# WLLR_CONFIG/WLLR_AUTH pointed at a repo path — must never be committable.
auth.json
config.yaml
.wllr/
*credentials*
*.pem

# Extension configuration belongs in ~/.wllr/extensions/<name>/, not the repo.
# The example under modules/mcp/ is intentionally tracked and named differently
# so this pattern cannot hide it.

# Editor/IDE
# .idea/
# .vscode/

# Build output — regenerated by `make all`
dist/
.cache/

# macOS
.DS_Store

# bob/pi working directory
.bob/
features.md

# Local agent working state and extension build artifacts
.claude/
extensions/agents/agents
*.wasm
cmd/cmd

# Compiled extension binaries
history
extensions/lsp/lsp
extensions/lsp/lsp_enhanced
