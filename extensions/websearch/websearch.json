{
  "name": "websearch",
  "version": "1.0.0",
  "description": "Web search capabilities through HTTP GET requests",
  "permissions": ["network_read"],
  "tools": [
    {
      "name": "web_search",
      "description": "Search DuckDuckGo's HTML web results without an API key. Returns ranked results with title, link, and snippet.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "The search query to execute"
          }
        },
        "required": ["query"]
      },
      "outputSchema": {
        "type": "array",
        "description": "Array of search results",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "link": {
              "type": "string"
            },
            "snippet": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
